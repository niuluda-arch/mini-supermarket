/* Nail 小程序字体规范 */
page {
  font-family: "Noto Sans SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.6;
  color: #202124;
  text-rendering: optimizeLegibility;
}

view, text, input, textarea, button, picker { font-family: inherit; }

.type-page-title { font-size: 36rpx; font-weight: 600; line-height: 1.2; }
.type-display { font-size: 46rpx; font-weight: 700; line-height: 1.2; }
.type-nav-title { font-size: 30rpx; font-weight: 600; line-height: 1.2; text-align: center; }
.type-section-title { font-size: 32rpx; font-weight: 600; line-height: 1.45; }
.type-card-title { font-size: 30rpx; font-weight: 600; line-height: 1.45; }
.type-body { font-size: 28rpx; font-weight: 400; line-height: 1.6; }
.type-body-secondary { font-size: 26rpx; font-weight: 400; line-height: 1.6; color: #777; }
.type-caption { font-size: 24rpx; font-weight: 400; line-height: 1.45; color: #777; }
.type-label { font-size: 22rpx; font-weight: 400; line-height: 28rpx; }
.type-button { font-size: 30rpx; font-weight: 600; line-height: 1.2; }
.type-number { font-size: 32rpx; font-weight: 500; line-height: 1.3; color: #d83e5b; }

.weight-regular { font-weight: 400; }
.weight-medium { font-weight: 500; }
.weight-semibold { font-weight: 600; }
.weight-bold { font-weight: 700; }
