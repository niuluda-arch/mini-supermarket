@import "/styles/typography-system.wxss";

page{background:#f7f7f4;color:#20252b}button{font-size:26rpx;margin:0;padding:0 24rpx;line-height:2.5;background:#eee;color:#333;border-radius:30rpx}button::after{border:0}button[disabled]{opacity:.4}view,button,input{box-sizing:border-box}.muted{color:#929292}.primary{background:#0db15a;color:#fff}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.title{font-size:36rpx;font-weight:700}.placeholder{display:flex;align-items:center;justify-content:center;background:#e5e5e7;color:#7f7f84;border-radius:20rpx}.icon{font-size:16rpx;font-weight:400;color:#888}.empty{padding:80rpx 20rpx;text-align:center;color:#888}.empty button{margin:28rpx auto 0;max-width:260rpx}.pill{border-radius:40rpx;background:#fff;padding:16rpx 24rpx}.selected{background:#0db15a!important;color:#fff!important}.section{margin-top:30rpx}.small{font-size:24rpx}.price{font-size:34rpx;font-weight:bold}.old{font-size:22rpx;text-decoration:line-through;color:#aaa;margin-left:10rpx}
/* Override WeChat v2's button:not([size='mini']) fixed width. */
button:not([size='mini']){width:auto;min-width:0;margin:0;padding:0 24rpx;font-size:26rpx;font-weight:400;line-height:2.5}
