<swiper wx:if="{{tab === '首页'}}" class="banner-swiper" autoplay="true" interval="3500" duration="500" circular="true" indicator-dots="true"><swiper-item wx:for="{{['fresh-banner.png','fresh-banner-vegetables.png','fresh-banner-fruits.png','fresh-banner-seafood.png']}}" wx:key="*this"><view class="carousel-banner"><view class="banner-copy"><view class="banner-title">{{index === 0 ? '新鲜直达 · 限时特惠' : index === 1 ? '时令蔬菜 · 清爽上新' : index === 2 ? '当季鲜果 · 甜蜜到家' : '鲜活海产 · 新鲜看得见'}}</view><view class="small">精选生鲜，限时特价抢购</view><button bindtap="promotion">马上去抢</button></view></view></swiper-item></swiper>
<view class="shell">
 <block wx:if="{{tab === '首页' || tab === '分类'}}">
  <view class="row location-row"><view class="address" bindtap="openPanel" data-panel="store"><view class="row"><image class="location-icon" src="https://niuluda.oss-cn-beijing.aliyuncs.com/weixin/market/assets/home/icon-location.png" mode="aspectFit"/><text class="address-text">{{store}}</text></view><view class="muted small">到店自提 · 满39享优惠</view></view></view>
  <view class="search row"><image class="search-icon" src="https://niuluda.oss-cn-beijing.aliyuncs.com/weixin/market/assets/home/icon-search.png" mode="aspectFit"/><input value="{{query}}" bindinput="inputSearch" bindconfirm="search" confirm-type="search" placeholder="请输入商品名称"/><button wx:if="{{query}}" class="text-button" bindtap="clearSearch">清空</button><button class="text-button" bindtap="search">搜索</button></view>
  <view wx:if="{{tab === '首页'}}" class="banner row"><view class="banner-copy"><view class="banner-title">新鲜直达 · 限时特惠</view><view class="small">生鲜满39减10，天天有低价</view><button bindtap="promotion">马上去抢</button></view></view>
  <view class="row section"><text class="title">{{promo ? '限时特惠' : (tab === '分类' ? '全部商品' : '今日推荐')}}</text><button class="text-button muted" bindtap="viewAll">查看全部 <image class="chevron" src="https://niuluda.oss-cn-beijing.aliyuncs.com/weixin/market/assets/home/icon-chevron-right.png" mode="aspectFit"/></button></view>
  <scroll-view scroll-x class="categories"><view class="category-row"><button wx:for="{{categories}}" wx:key="*this" class="pill {{category === item ? 'selected' : ''}}" data-category="{{item}}" bindtap="chooseCategory">{{item}}</button></view></scroll-view>
  <view wx:if="{{submitted || promo}}" class="row filter-note"><text>{{promo ? '活动商品' : '搜索：' + submitted}}</text><button class="text-button" bindtap="clearSearch">重置</button></view>
  <view wx:if="{{status === 'loading'}}" class="empty">正在加载商品…</view>
  <view wx:elif="{{status === 'error'}}" class="empty">商品加载失败，请重试<button bindtap="loadProducts">重新加载</button></view>
  <view wx:elif="{{!products.length}}" class="empty">没有找到匹配商品<button bindtap="clearSearch">查看全部商品</button></view>
  <view wx:else class="grid"><view class="product" wx:for="{{products}}" wx:key="id"><view bindtap="openDetail" data-id="{{item.id}}"><image class="product-image product-cover" src="{{item.image}}" mode="aspectFill"/><view class="product-name">{{item.name}}</view><view class="muted small product-detail">{{item.detail}}</view></view><view class="row"><view><text class="price">¥{{item.priceText}}</text><text class="old">¥{{item.oldText}}</text></view><button class="add" data-id="{{item.id}}" bindtap="addProduct" aria-label="加入购物车"><image src="https://niuluda.oss-cn-beijing.aliyuncs.com/weixin/market/assets/home/icon-add-cart.png" mode="aspectFit"/></button></view></view></view>
 </block>
 <block wx:if="{{tab === '购物车'}}">
  <view class="row"><text class="title">购物车</text><button class="text-button" bindtap="edit">{{editing ? '完成' : '编辑'}}</button></view>
  <view wx:if="{{!cartRows.length}}" class="empty">购物车还是空的<button class="primary" bindtap="goHome">去挑选商品</button></view>
  <view wx:else class="store section"><button class="store-heading text-button" bindtap="toggleAll">{{allSelected ? '已全选' : '全选'}} · 惠民超市旗舰店</button><view class="cart-item" wx:for="{{cartRows}}" wx:key="id"><button class="check {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggleItem">{{item.selected ? '已选' : '选中'}}</button><image class="cart-image product-cover" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" bindtap="openDetail"/><view class="cart-info"><view class="product-name">{{item.name}}</view><view class="small muted">{{item.detail}}</view><view class="row"><text class="price">¥{{item.priceText}}</text><view class="stepper"><button data-id="{{item.id}}" data-delta="-1" bindtap="quantity" disabled="{{item.qty <= 1}}">减</button><text>{{item.qty}}</text><button data-id="{{item.id}}" data-delta="1" bindtap="quantity" disabled="{{item.qty >= 99}}">加</button></view></view><button wx:if="{{editing}}" class="text-button" data-id="{{item.id}}" bindtap="remove">删除商品</button></view></view></view>
  <button wx:if="{{cartRows.length}}" class="coupon row section" bindtap="coupon"><text>优惠券 · 满39减10</text><text>{{coupon ? '取消使用' : '使用'}}</text></button>
  <view class="row section"><text class="title">猜你喜欢</text><button class="text-button" bindtap="rotate">换一批</button></view><view class="grid section"><view class="product" wx:for="{{recommendations}}" wx:key="id"><image class="product-image product-cover" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" bindtap="openDetail"/><view class="product-name">{{item.name}}</view><view class="row"><text class="price">¥{{item.priceText}}</text><button class="add" data-id="{{item.id}}" bindtap="addProduct"><image src="https://niuluda.oss-cn-beijing.aliyuncs.com/weixin/market/assets/home/icon-add-cart.png" mode="aspectFit"/></button></view></view></view>
  <view class="checkout-bar row"><view><view class="small muted">已优惠 ¥{{discount}}</view><text>合计 </text><text class="price">¥{{total}}</text></view><button class="primary" disabled="{{!selectedCount}}" bindtap="checkout">提交订单({{selectedCount}})</button></view>
 </block>
 <block wx:if="{{tab === '我的'}}"><view class="my-page"><text class="title">我的</text><view class="profile-card section"><image class="profile-avatar" src="https://niuluda.oss-cn-beijing.aliyuncs.com/weixin/market/assets/home/icon-nav-profile.png" mode="aspectFit"/><view class="profile-copy"><view class="profile-name">超市体验用户</view><text>已加入惠民超市</text></view></view><view class="order-card section"><view class="row order-card-head" bindtap="showOrders"><view><text class="order-card-title">我的订单</text><text class="order-count">{{orders.length}} 笔订单</text></view><view><text>查看全部</text><image class="order-chevron" src="https://niuluda.oss-cn-beijing.aliyuncs.com/weixin/market/assets/home/icon-chevron-right.png" mode="aspectFit"/></view></view><view class="order-states"><view bindtap="showOrders"><text>{{orders.length}}</text><text>全部订单</text></view><view bindtap="showOrders"><text>0</text><text>进行中</text></view><view bindtap="showOrders"><text>0</text><text>已完成</text></view></view></view><view class="order-tip"><text class="order-tip-title">订单服务</text><text>下单后可在这里查看订单记录</text><button class="primary" bindtap="goHome">去选购商品</button></view></view></block>
</view>
<view class="nav-wrap"><view class="nav"><button wx:for="{{tabs}}" wx:key="*this" class="nav-item {{tab === item ? 'selected' : ''}}" data-tab="{{item}}" bindtap="switchTab"><image class="nav-icon" src="{{navAssets[item]}}" mode="aspectFit"/><view>{{item}}<text wx:if="{{item === '购物车' && cartCount}}">({{cartCount}})</text></view></button></view></view>
<view wx:if="{{panel}}" class="overlay" bindtap="closePanel"><view class="sheet" catchtap="noop"><view class="row sheet-heading"><text class="title">{{panel === 'store' ? '选择自提门店' : panel === 'detail' ? '商品详情' : panel === 'checkout' ? '确认订单' : panel === 'success' ? '提交成功' : panel === 'orders' ? '我的订单' : panel === 'states' ? '原型状态预览' : '门店通知'}}</text><button class="text-button" bindtap="closePanel">返回</button></view><scroll-view scroll-y class="sheet-body">
 <block wx:if="{{panel === 'store'}}"><button wx:for="{{stores}}" wx:key="*this" class="menu {{storeDraft === item ? 'selected' : ''}}" data-store="{{item}}" bindtap="chooseStore">{{item}}</button><button class="primary section" bindtap="saveStore">确认门店</button></block>
 <block wx:if="{{panel === 'messages'}}"><view class="menu">门店下单服务已开放，提交订单后请到店自提。</view><view class="menu">今日生鲜优惠：满39元减10元。</view></block>
 <block wx:if="{{panel === 'detail'}}"><image class="detail-image product-cover" src="{{detail.image}}" mode="aspectFill"/><view class="title section">{{detail.name}}</view><view class="muted section">{{detail.detail}}</view><view class="row section"><text class="price">¥{{detail.priceText}}</text><view class="stepper"><button data-delta="-1" bindtap="detailQuantity" disabled="{{detailQty <= 1}}">减</button><text>{{detailQty}}</text><button data-delta="1" bindtap="detailQuantity" disabled="{{detailQty >= 99}}">加</button></view></view><button class="primary section" bindtap="addDetail">加入购物车</button></block>
 <block wx:if="{{panel === 'checkout'}}"><view class="menu">自提门店：{{store}}</view><view class="menu">共 {{selectedCount}} 件商品 · 商品金额 ¥{{subtotal}}</view><view class="menu">优惠 ¥{{discount}} · 应付 ¥{{total}}</view><view class="small muted section">本次为演示订单，不接入支付，提交后可在“我的订单”查看。</view><button class="primary section" bindtap="submitOrder" loading="{{status === 'submitting'}}" disabled="{{status === 'submitting'}}">{{status === 'submitting' ? '正在提交' : '确认提交订单'}}</button></block>
 <block wx:if="{{panel === 'success'}}"><view class="empty">订单提交成功，可在“我的订单”查看。</view><button class="primary" bindtap="showOrders">查看订单</button><button class="section" bindtap="goHome">继续购物</button></block>
 <block wx:if="{{panel === 'orders'}}"><view wx:if="{{!orders.length}}" class="empty">还没有订单</view><view wx:for="{{orders}}" wx:key="id" class="menu"><view>订单 · {{item.count}}件 · ¥{{item.total}}</view><view class="small muted">自提门店：{{item.store}}</view></view></block>
 <block wx:if="{{panel === 'states'}}"><text class="small muted">仅用于检查原型状态，返回“查看全部商品”可恢复。</text><button class="menu" data-state="loading" bindtap="simulate">加载中</button><button class="menu" data-state="empty" bindtap="simulate">空列表</button><button class="menu" data-state="error" bindtap="simulate">加载失败与重试</button></block>
</scroll-view></view></view>
