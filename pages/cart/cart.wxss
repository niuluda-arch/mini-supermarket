.cart-page { min-height:100vh; padding:38rpx 28rpx 150rpx; box-sizing:border-box; background:#f4f4f1; }.header,.store-title,.cart-item,.coupon,.checkout,.recommend-title { display:flex; align-items:center; }.header { justify-content:space-between; margin-bottom:34rpx; font-size:40rpx; font-weight:700; }.header text:last-child { color:#555; font-size:28rpx; font-weight:400; }.store-card,.coupon { background:#fff; border-radius:28rpx; }.store-card { padding:28rpx; }.store-title { margin-bottom:26rpx; font-size:30rpx; font-weight:700; }.cart-item { position:relative; margin-top:22rpx; }.check { width:34rpx; height:34rpx; margin-right:18rpx; border:3rpx solid #a8adb3; border-radius:50%; text-align:center; color:#fff; line-height:30rpx; }.checked { border-color:#666; background:#666; }.thumb { display:flex; width:126rpx; height:126rpx; flex:none; align-items:center; justify-content:center; border:2rpx dashed #999; border-radius:16rpx; color:#888; text-align:center; font-size:20rpx; }.item-info { display:flex; min-width:0; padding-left:18rpx; flex:1; flex-direction:column; }.item-name { font-weight:700; font-size:28rpx; }.item-detail { margin:10rpx 0; color:#969ba2; font-size:23rpx; }.item-price { color:#444; font-size:32rpx; font-weight:700; }.stepper { display:flex; overflow:hidden; align-items:center; border:2rpx solid #bbb; border-radius:28rpx; }.stepper text { min-width:46rpx; height:48rpx; text-align:center; line-height:48rpx; }.stepper text:nth-child(2) { border-right:2rpx solid #ddd; border-left:2rpx solid #ddd; }.coupon { justify-content:space-between; margin:28rpx 0; padding:28rpx; color:#656b72; font-size:28rpx; }.coupon-tag { padding:9rpx 16rpx; border:2rpx dashed #aaa; border-radius:12rpx; font-size:24rpx; }.coupon-on { background:#777; color:#fff; }.recommend-title { justify-content:space-between; font-size:38rpx; font-weight:700; }.recommend-title text { color:#92979d; font-size:25rpx; font-weight:400; }.recommend-grid { display:grid; grid-template-columns:repeat(2, 1fr); gap:24rpx; margin-top:22rpx; }.recommend { padding:16rpx; border-radius:25rpx; background:#fff; }.recommend view { display:flex; height:144rpx; align-items:center; justify-content:center; border:2rpx dashed #999; border-radius:18rpx; color:#888; text-align:center; font-size:21rpx; }.recommend text { display:block; margin:16rpx 0; font-size:27rpx; font-weight:700; }.recommend b { color:#444; font-size:29rpx; }.checkout { position:fixed; right:0; bottom:0; left:0; height:116rpx; padding:0 28rpx; justify-content:space-between; background:#fff; box-sizing:border-box; color:#737980; }.checkout b { color:#333; font-size:38rpx; }.checkout button { width:250rpx; border-radius:48rpx; background:#626262; color:#fff; font-size:30rpx; font-weight:700; }
