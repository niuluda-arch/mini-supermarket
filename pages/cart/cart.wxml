<view class="cart-page"><view class="header"><text>购物车</text><text>编辑</text></view><view class="store-card"><view class="store-title">☑　惠民超市旗舰店　〉</view><view class="cart-item" wx:for="{{items}}" wx:key="id"><view class="check {{item.selected ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="toggleItem">{{item.selected ? '✓' : ''}}</view><view class="thumb">商品图片<br/>占位</view><view class="item-info"><text class="item-name">{{item.name}}</text><text class="item-detail">{{item.detail}}</text><text class="item-price">¥{{item.price}}</text></view><view class="stepper"><text data-id="{{item.id}}" data-delta="-1" bindtap="changeItem">−</text><text>{{item.quantity}}</text><text data-id="{{item.id}}" data-delta="1" bindtap="changeItem">＋</text></view></view></view><view class="coupon" bindtap="toggleCoupon"><text>优惠券</text><text class="coupon-tag {{couponSelected ? 'coupon-on' : ''}}">{{couponSelected ? '已使用' : '满39减10'}}</text><text>去使用 〉</text></view><view class="section"><view class="recommend-title">猜你喜欢 <text>换一批</text></view><view class="recommend-grid"><view class="recommend"><view>商品图片<br/>占位</view><text>东北珍珠米 5kg</text><b>¥29.9　＋</b></view><view class="recommend"><view>商品图片<br/>占位</view><text>冷鲜五花肉 300g</text><b>¥25.9　＋</b></view></view></view><view class="checkout"><text>合计 <b>¥{{summary.total}}</b></text><button bindtap="checkout">去结算({{summary.count}})</button></view></view>
