.page { min-height: 100vh; padding: 34rpx 28rpx 150rpx; box-sizing: border-box; }
.location-row,.section-title,.price-row,.tab-row,.bottom-nav,.banner { display:flex; align-items:center; }
.location-row { justify-content:space-between; margin:12rpx 0 34rpx; }.icon-box { display:inline-flex; width:34rpx; height:34rpx; margin-right:12rpx; align-items:center; justify-content:center; color:#777; border:2rpx solid #888; border-radius:50%; font-size:18rpx; }.location { font-size:32rpx; font-weight:700; }.sub { display:block; margin-top:10rpx; color:#91979f; font-size:24rpx; }.notice { width:78rpx; height:78rpx; padding:0; border-radius:50%; background:#fff; color:#777; font-size:16rpx; line-height:24rpx; }.search { padding:24rpx; background:#fff; color:#a0a5ab; border-radius:44rpx; font-size:28rpx; }.banner { margin:32rpx 0 40rpx; min-height:190rpx; padding:28rpx 36rpx; border:2rpx dashed #7c7c7c; border-radius:30rpx; background:#dedede; justify-content:space-between; color:#454545; font-size:26rpx; }.banner-title { display:block; margin-bottom:14rpx; font-size:38rpx; font-weight:700; }.banner button { margin:16rpx 0 0; padding:0 24rpx; border:2rpx solid #666; border-radius:32rpx; background:#fff; font-size:24rpx; }.banner-icon { display:flex; width:110rpx; height:110rpx; border:2rpx dashed #777; border-radius:50%; align-items:center; justify-content:center; text-align:center; font-size:20rpx; }.section-title { justify-content:space-between; font-size:38rpx; font-weight:700; }.more { color:#92979d; font-size:26rpx; font-weight:400; }.tabs { margin:24rpx 0; white-space:nowrap; }.tab { display:inline-block; padding:18rpx 28rpx; margin-right:16rpx; border:2rpx solid #b0b0b0; border-radius:30rpx; background:#fff; color:#5f646b; }.tab.active { border-color:#444; background:#777; color:#fff; }.grid { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:24rpx; }.card { padding:16rpx; border-radius:28rpx; background:#fff; }.image-placeholder { display:flex; height:180rpx; border:2rpx dashed #9b9b9b; border-radius:18rpx; align-items:center; justify-content:center; color:#858585; text-align:center; }.product-name { display:block; margin-top:18rpx; font-size:28rpx; font-weight:700; }.product-detail { display:block; margin:10rpx 0; color:#989da3; font-size:23rpx; }.price-row { justify-content:space-between; color:#444; font-size:34rpx; font-weight:700; }.price-row button { width:56rpx; height:56rpx; padding:0; border-radius:50%; background:#727272; color:#fff; font-size:38rpx; line-height:52rpx; }.bottom-nav { position:fixed; right:0; bottom:0; left:0; height:116rpx; justify-content:space-around; border-top:2rpx solid #ddd; background:#fff; }.nav { display:flex; min-width:110rpx; flex-direction:column; align-items:center; color:#92979e; font-size:18rpx; }.nav text { margin-top:4rpx; font-size:21rpx; }.active-nav { color:#333; font-weight:700; }
