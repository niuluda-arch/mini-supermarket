<view class="page">
  <view class="location-row">
    <view><text class="icon-box">图</text><text class="location">欢乐家园3期 · 北门⌄</text><text class="sub">1小时达 · 满39免配送费</text></view>
    <button class="notice" bindtap="showNotice">图标<br/>占位</button>
  </view>
  <view class="search">🔍　搜索：牛奶、西瓜、纸巾…</view>
  <view class="banner"><view><text class="banner-title">新鲜直达 · 限时特惠</text><text>生鲜满39减10，天天有低价</text><button bindtap="goCart">马上去抢</button></view><view class="banner-icon">图片<br/>占位</view></view>
  <view class="section-title"><text>今日推荐</text><text class="more">查看全部 〉</text></view>
  <scroll-view class="tabs" scroll-x="true"><view class="tab-row"><view wx:for="{{tabs}}" wx:key="*this" class="tab {{activeTab === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="chooseTab">{{item}}</view></view></scroll-view>
  <view class="grid"><view class="card" wx:for="{{products}}" wx:key="id"><view class="image-placeholder">商品图片<br/>占位</view><text class="product-name">{{item.name}}</text><text class="product-detail">{{item.detail}}</text><view class="price-row"><text>¥{{item.price}}</text><button data-id="{{item.id}}" bindtap="addProduct">＋</button></view></view></view>
  <view class="bottom-nav"><view class="nav active-nav">图标占位<text>首页</text></view><view class="nav">图标占位<text>分类</text></view><view class="nav" bindtap="goCart">图标占位<text>购物车 {{cartCount ? '(' + cartCount + ')' : ''}}</text></view><view class="nav">图标占位<text>我的</text></view></view>
</view>
